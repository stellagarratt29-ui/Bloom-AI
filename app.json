{
  "expo": {
    "name": "Bloom AI",
    "slug": "bloom-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bloomai",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stellagarratt29.bloomai",
      "buildNumber": "1",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Bloom uses Google Calendar to show your upcoming events and help you manage your schedule."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "com.stellagarratt29.bloomai",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Bloom AI",
      "shortName": "Bloom",
      "description": "Your personal productivity companion. Brain-dump your day and Bloom sorts it into a clear, doable plan.",
      "themeColor": "#C07A90",
      "backgroundColor": "#FAFAFA",
      "display": "standalone",
      "startUrl": "."
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bloom uses your location to calculate travel time to your upcoming calendar events."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C07A90",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
